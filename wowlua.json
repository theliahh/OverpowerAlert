{
  "$schema": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json",
  "package": {
    "name": "overpower-alert",
    "version": "0.1.0",
    "wowlua": "^0.13"
  },
  "addon": {
    "title": "Overpower Alert",
    "saved-variables": [
      "OverpowerAlertDB"
    ]
  },
  "flavors": {
    "camelot": {}
  },
  "build": {
    "src": ".",
    "exclude": [
      "docs/**",
      ".github/**",
      "dist/**"

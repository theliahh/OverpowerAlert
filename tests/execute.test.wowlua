-- Execute: off by default; once on, up while the target is below 20% health,
-- read from the game's own usability since target health is hidden (the
-- emulator hides it too, so these run the real path).
import test, beforeEach, afterEach, expect, config from "wowlua:test"
import * as mock from "wowlua:mock"

config({ profile = "warrior" })

local _, ns = ...

local EXECUTE = 20662 -- the rank the warrior profile knows
local STANCES = { 2457, 71, 2458 } -- Battle, Defensive, Berserker
local stance = 1
local usable = false

@beforeEach
local function setup()
    stance, usable = 1, false
    mock.fake("GetShapeshiftForm", function() return stance end)
    mock.fake("GetShapeshiftFormInfo", function(i) return nil, nil, nil, STANCES[i] end)
    mock.stub(C_Spell, "IsSpellUsable", function(id)
        if id == EXECUTE then return usable, false end
        return false, false
    end)
    ns.Config("execute").enabled = true
    mock.player:enterCombat()
end

@afterEach
local function settle()
    usable = false
    mock.fireEvent("SPELL_UPDATE_USABLE")
    mock.waitSeconds(2)
    mock.player:leaveCombat()
end

local function icon()
    return _G["OverpowerAlertExecuteIconFrame"]
end

local function setUsable(v)
    usable = v
    mock.fireEvent("SPELL_UPDATE_USABLE")
    mock.waitFrames(2)
end

@test("off by default, with no sound or text")
local function defaults()
    -- The profile's saved settings start from the defaults; check what they were.
    expect(ns.Config("execute").sound).toBe("NONE")
    expect(ns.Config("execute").showText).toBe(false)
    ns.Config("execute").enabled = false
    setUsable(true)
    expect(icon()).never.toBeShown()
end

@test("shows when Execute becomes usable, and stays up past 5 seconds")
local function usableShows()
    setUsable(true)
    expect(icon()).toBeShown()
    expect(_G["OverpowerAlertExecuteTextFrame"]).never.toBeShown()
    mock.waitSeconds(8)
    expect(icon()).toBeShown()
end

@test("casting it doesn't hide it")
local function castKeeps()
    setUsable(true)
    mock.fireUnitEvent("UNIT_SPELLCAST_SUCCEEDED", "player", "Cast-1", EXECUTE)
    mock.waitSeconds(2)
    expect(icon()).toBeShown()
end

@test("hides when it stops being usable (target died or healed)")
local function usableEnds()
    setUsable(true)
    mock.waitSeconds(1)
    setUsable(false)
    mock.waitSeconds(1.5)
    expect(icon()).never.toBeShown()
end

local function countAlerts()
    local count = 0
    local real = ns.PreviewAlert
    ns.PreviewAlert = function(key, ...)
        if key == "execute" then count = count + 1 end
        return real(key, ...)
    end
    return function()
        ns.PreviewAlert = real
        return count
    end
end

@test("switching back to Battle Stance doesn't alert again while the game catches up")
local function battleAgain()
    local alerts = countAlerts()
    setUsable(true)
    stance = 2
    usable = false
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    mock.waitSeconds(1)
    -- Back to Battle: for a moment the game still says it isn't usable
    -- (seen in-game), then catches up.
    stance = 1
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    mock.waitSeconds(0.1)
    expect(icon()).toBeShown()
    setUsable(true)
    mock.waitSeconds(1)
    expect(icon()).toBeShown()
    expect(alerts()).toBe(1)
end

@test("back in Battle Stance and still not usable once settled: it's over")
local function battleOver()
    setUsable(true)
    stance = 2
    usable = false
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    mock.waitSeconds(1)
    stance = 1
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    mock.waitSeconds(2) -- past the settle time and the fade
    expect(icon()).never.toBeShown()
end

-- In Defensive Stance, ticked: the icon follows the target's health. The
-- real alpha is secret, so these stand in for it.
local function body()
    -- The icon's look, under its rage layer; its alpha is the one set.
    local rageLayer = icon():GetChildren()
    return (rageLayer:GetChildren())
end

local function defensive(alpha)
    ns.Config("execute").stances.defensive = true
    mock.stub(ns, "ExecuteAlpha", function() return alpha.value end)
    stance = 2
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    mock.waitSeconds(0.2)
end

@test("Defensive Stance, ticked: the icon is see-through above 20%, shown below, with no alert")
local function watchDefensive()
    local alerts = countAlerts()
    local alpha = { value = 0 }
    defensive(alpha)
    expect(icon()).toBeShown()
    expect(body():GetAlpha()).toBe(0)
    alpha.value = 1 -- the target drops below 20%
    mock.waitSeconds(0.2)
    expect(body():GetAlpha()).toBe(1)
    mock.waitSeconds(3)
    expect(icon()).toBeShown()
    expect(alerts()).toBe(0) -- no sound or text
    expect(_G["OverpowerAlertExecuteTextFrame"]).never.toBeShown()
    ns.Config("execute").stances.defensive = false
end

@test("Defensive Stance with a rage threshold fade: health and rage each set their own alpha")
local function watchWithRage()
    local rage = { value = 0 }
    mock.stub(ns, "RageLook", function(abilityKey)
        if abilityKey == "execute" then return "fade", rage.value end
    end)
    local alpha = { value = 1 } -- the target is below 20%
    defensive(alpha)
    local rageLayer = icon():GetChildren()
    expect(icon()).toBeShown()
    expect(body():GetAlpha()).toBe(1)
    expect(rageLayer:GetAlpha()).toBe(0) -- not enough rage: still hidden
    rage.value, alpha.value = 1, 0 -- enough rage, but the target healed
    mock.waitSeconds(0.2)
    expect(body():GetAlpha()).toBe(0)
    expect(rageLayer:GetAlpha()).toBe(1)
    ns.Config("execute").stances.defensive = false
end

@test("Defensive Stance, not ticked: nothing")
local function watchUnticked()
    stance = 2
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    mock.waitSeconds(0.5)
    expect(icon()).never.toBeShown()
end

@test("from watching to Battle Stance below 20%: a real alert, in full")
local function watchToBattle()
    local alerts = countAlerts()
    local alpha = { value = 1 }
    defensive(alpha)
    stance = 1
    setUsable(true)
    mock.waitSeconds(0.2)
    expect(alerts()).toBe(1)
    expect(icon()).toBeShown()
    expect(body():GetAlpha()).toBe(1)
    ns.Config("execute").stances.defensive = false
end

@test("from watching to Battle Stance above 20%: it goes")
local function watchToBattleAbove()
    local alpha = { value = 0 }
    defensive(alpha)
    stance = 1
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    mock.waitSeconds(2.5)
    expect(icon()).never.toBeShown()
    ns.Config("execute").stances.defensive = false
end

@test("switching to Defensive Stance keeps it up")
local function defensiveKeeps()
    setUsable(true)
    stance = 2
    usable = false -- not castable in Defensive Stance
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    mock.waitSeconds(2)
    expect(icon()).toBeShown()
end

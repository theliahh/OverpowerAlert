-- Talent sets: with the option on (General tab), each talent set uses its own
-- profile, and swapping talents switches to it.
import test, beforeEach, afterEach, expect, config from "wowlua:test"
import * as mock from "wowlua:mock"

config({ profile = "warrior" })

local _, ns = ...

local specGroup = 1

local function swapTo(group, event)
    local prev = specGroup
    specGroup = group
    if event then
        mock.fireEvent(event)
    else
        mock.fireEvent("ACTIVE_TALENT_GROUP_CHANGED", group, prev)
    end
end

local function iconWidth()
    return math.floor(_G["OverpowerAlertOverpowerIconFrame"]:GetWidth() + 0.5)
end

-- "Tank": a profile with a bigger Overpower icon.
local function makeTank()
    ns.NewProfile("Tank")
    ns.Config("overpower").iconSize = 120
    ns.SetProfile("Default")
end

@beforeEach
local function setup()
    specGroup = 1
    mock.stub(C_SpecializationInfo, "GetActiveSpecGroup", function() return specGroup end)
end

@afterEach
local function reset()
    specGroup = 1
    ns.SetPerSpec(false)
    ns.SetProfile("Default")
    for _, name in ipairs(ns.ProfileNames()) do
        if name ~= "Default" then ns.DeleteProfile(name) end
    end
end

@test("off by default: swapping talents changes nothing")
local function offByDefault()
    makeTank()
    expect(ns.PerSpec()).toBe(false)
    swapTo(2)
    expect(ns.ActiveProfileName()).toBe("Default")
    expect(iconWidth()).toBe(64)
end

@test("on: each talent set uses its profile, and a swap applies it")
local function perSet()
    makeTank()
    ns.SetPerSpec(true)
    ns.SetSpecProfile(2, "Tank")
    expect(ns.ActiveProfileName()).toBe("Default") -- still on set 1
    swapTo(2)
    expect(ns.ActiveProfileName()).toBe("Tank")
    expect(iconWidth()).toBe(120)
    swapTo(1)
    expect(ns.ActiveProfileName()).toBe("Default")
    expect(iconWidth()).toBe(64)
end

@test("a swap says in chat which profile is now in use")
local function announces()
    makeTank()
    ns.SetPerSpec(true)
    ns.SetSpecProfile(2, "Tank")
    swapTo(2)
    local said = table.concat(mock.printed(), "\n")
    expect(said:find("Tank", 1, true) ~= nil).toBe(true)
end

@test("choosing a profile while on set 2 changes only set 2's")
local function dropdownSetsCurrent()
    makeTank()
    ns.SetPerSpec(true)
    swapTo(2)
    ns.SetProfile("Tank")
    expect(ns.SpecProfile(2)).toBe("Tank")
    expect(ns.SpecProfile(1)).toBe("Default")
end

@test("turning it on gives the profile in use to both sets, so nothing changes")
local function seedsBoth()
    makeTank()
    specGroup = 2
    ns.SetProfile("Tank")
    ns.SetPerSpec(true)
    expect(ns.SpecProfile(1)).toBe("Tank")
    expect(ns.SpecProfile(2)).toBe("Tank")
    expect(ns.ActiveProfileName()).toBe("Tank")
end

@test("turning it off keeps the profile in use")
local function offKeeps()
    makeTank()
    ns.SetPerSpec(true)
    ns.SetSpecProfile(2, "Tank")
    swapTo(2)
    ns.SetPerSpec(false)
    expect(ns.ActiveProfileName()).toBe("Tank")
    swapTo(1)
    expect(ns.ActiveProfileName()).toBe("Tank")
end

@test("deleting set 2's profile moves set 2 to Default")
local function deleteSetProfile()
    makeTank()
    ns.SetPerSpec(true)
    ns.SetSpecProfile(2, "Tank")
    ns.DeleteProfile("Tank")
    expect(ns.SpecProfile(2)).toBe("Default")
    swapTo(2)
    expect(ns.ActiveProfileName()).toBe("Default")
end

@test("the spellbook changing or a talent update also notices a swap")
local function otherEvents()
    makeTank()
    ns.SetPerSpec(true)
    ns.SetSpecProfile(2, "Tank")
    swapTo(2, "SPELLS_CHANGED")
    expect(ns.ActiveProfileName()).toBe("Tank")
    swapTo(1, "PLAYER_TALENT_UPDATE")
    expect(ns.ActiveProfileName()).toBe("Default")
end
